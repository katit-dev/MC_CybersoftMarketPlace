

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5014",
      "https://localhost:7265",
      "http://localhost:5071",
      "https://localhost:7274",
      "http://localhost:5192",
      "https://localhost:7245",
      "http://localhost:5176",
      "https://localhost:7200"
    ]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "product-order-route": {
        "ClusterId": "productOrderCluster",
        "Match": {
          "Path": "/mc-product-order/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/mc-product-order" }
        ]
      },
      "user-route": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/mc-user/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/mc-user" }
        ]
      },
      "payment-route": {
        "ClusterId": "paymentCluster",
        "Match": {
          "Path": "/mc-payment/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/mc-payment" }
        ]
      }
    },
    "Clusters": {
      "productOrderCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5071/"
          }
        }
      },
      "userCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5192/"
          }
        }
      },
      "paymentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5176/"
          }
        }
      }
    }
  }
}
